# 复制为 .env 后按需改。docker-compose 与服务共用这些值。

# Postgres(docker-compose 起的实例)
POSTGRES_USER=xingjuan
POSTGRES_PASSWORD=xingjuan_dev_pwd
POSTGRES_DB=xingjuan
# 用 5433 避开本机 5432 上已有的 pg(如 langfuse 栈)
POSTGRES_PORT=5433

# 服务读取的连接串(指向上面的实例)
DATABASE_URL=postgres://xingjuan:xingjuan_dev_pwd@localhost:5433/xingjuan?sslmode=disable

# HTTP 服务端口(纯数字)。compose 用它做宿主/容器映射 + 后端监听;裸跑时后端也读它。
# 注意:改这里须同步 deploy/nginx.conf 的 proxy_pass backend:<port>(nginx 读不到本文件)。
HTTP_PORT=8089

# session cookie 有效期(小时)
SESSION_TTL_HOURS=168

# seed 账号:cmd/seed 只认命令行 flag(-account/-password/-name/-role),不读环境变量。
# 全栈 compose 的 init 已内置三个账号(见 docker-compose.yml):
#   admin/admin123(admin)、zhengwei/zhengwei(creator)、xiaoming/xiaoming(respondent)。
# 本机裸跑另建账号示例:go run ./cmd/seed -account foo -password bar -name 某某 -role creator

# ─────────────────────────────────────────────
# 全栈 docker-compose(db + backend + 前端两端)专用
# ─────────────────────────────────────────────
# 端口:前端对外 8088(compose 里写死),后端对外 = 上面的 HTTP_PORT(默认 8089)。浏览器访问 http://localhost:8088。
# 容器网络内后端连库的串:host=服务名 db、端口 5432(容器内,与宿主 POSTGRES_PORT 无关)。
DATABASE_URL_INTERNAL=postgres://xingjuan:xingjuan_dev_pwd@db:5432/xingjuan?sslmode=disable
# COOKIE_SECURE=true 仅在 HTTPS 部署时开(否则浏览器不下发 cookie,登录态丢失)。
COOKIE_SECURE=false
